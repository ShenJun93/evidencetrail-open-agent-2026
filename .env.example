# Public example only. Never put API keys/passwords in a tracked file.
# Zero-key judge mode: py -3 -m evidencetrail run --sample-mode --input samples/inputs/yagi_1630_lucyen.json
# To run authenticated local Zetaris, copy this file to ignored .env.local and fill two owner-managed fields only.
SAMPLE_MODE=true
EVIDENCETRAIL_MODE=REPORTED_DATELINE_REPLAY

# Actual bounded local Zetaris SQL Editor REST API, NOT legacy DBQuery/OpenSqlQuery.
ZETARIS_REST_MODE=sql_editor
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_QUERY_URL=
# Exact fixed 20-column projection from evidencetrail/adapters/zetaris_sql_editor.py.
ZETARIS_PUBLIC_SQL=SELECT source_id, record_kind, locator, publisher, paraphrase, excerpt, published_at_displayed_utc, observed_at_utc, issued_at_claimed_utc, first_availability_proven_utc, provenance_quality, historical_admin_vintage, spatial_scope, named_districts_2024, granularity, scenario_id, plan_predicates, metadata_conflicts, observation_fields, source_origin_label FROM EVIDENCETRAIL_YAGI.public_datelines LIMIT 20
ZETARIS_CAPACITY_SQL=SELECT source_id, record_kind, locator, publisher, paraphrase, excerpt, published_at_displayed_utc, observed_at_utc, issued_at_claimed_utc, first_availability_proven_utc, provenance_quality, historical_admin_vintage, spatial_scope, named_districts_2024, granularity, scenario_id, plan_predicates, metadata_conflicts, observation_fields, source_origin_label FROM EVIDENCETRAIL_YAGI.synthetic_capacity LIMIT 20
# Optional distinct targeted read-only query: blank unless a third independently admissible registered source exists.
ZETARIS_TARGETED_PUBLIC_SQL=

# Official H-MEM TS reference opt-in requires an independently reviewed local checkout
# at pinned upstream commit. Default Python reference is ONLY SAMPLE / UNIT and not sponsor acceptance.
HMEM_ENGINE_MODE=python_port
HMEM_PERSIST_DIR=./hmem_data
HMEM_UPSTREAM_COMMIT=1742dec56a66e58eef9dda2d2b865823758ca8cd

# Nightshift provider v4: endpoint is illustrative, not running unless independently verified.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP=evidencetrail
METERLESS_TIMEOUT_SEC=180

# Optional direct NVIDIA calls are separately labelled, never Nightshift.
# Do not place any paid key here; keep disabled for judge reproducibility.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
EVIDENCETRAIL_ALLOW_NVIDIA=false
